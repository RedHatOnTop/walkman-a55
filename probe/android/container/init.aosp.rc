# Minimal init.rc for the NW-A55 Android bring-up - AOSP/CM 12.1 variant.
#
# Derived from init.rc (the Fire-userland variant) with the Amazon classpath
# jars, resource package and group removed and LD_PRELOAD libsigchain.so added
# for ART. It is still deliberately NOT a stock FireOS/CM init.rc: it starts
# only what an Android
# 5.1 userspace needs to come up on the Walkman: ueventd so a fresh /dev gets
# populated, logd so there are logs, servicemanager, surfaceflinger and zygote.
#
# It mounts no partition (vold mounts only the microSD card, fstab.icx) and
# never reconfigures USB, so it does not touch
# /sys/class/android_usb and the adb link stays up. It is not confined to the
# container, though: /proc/sys/vm/overcommit_memory is a global kernel setting,
# and ueventd's coldboot writes uevents for every device in the system. Both are
# deliberate and neither survives a reboot.
#
# The container runs in its own mount namespace, made by probe/devtools/
# pivotinit.c, with the container root mounted over /. Android's init mounts
# tmpfs on /dev and mounts proc and sysfs at startup; those land inside the
# container's namespace, so the Sony stack's /dev, /proc and /sys are untouched.

on early-init
    start ueventd

on init
    sysclktz 0
    loglevel 7

    # Android sets this in on boot. Without it the heuristic overcommit check
    # refuses ART's heap reservations (dex2oat asked for 384 MB on a 456 MB
    # device and got ENOMEM out of mmap).
    write /proc/sys/vm/overcommit_memory 1
    # FireOS's init.rc:419-424. lmkd and ActivityManagerService write these
    # parameters, so system has to be able to reach them.
    write /proc/sys/vm/min_free_order_shift 4
    chown root system /sys/module/lowmemorykiller/parameters/adj
    chmod 0664 /sys/module/lowmemorykiller/parameters/adj
    chown root system /sys/module/lowmemorykiller/parameters/minfree
    chmod 0664 /sys/module/lowmemorykiller/parameters/minfree

    export PATH /sbin:/system/sbin:/system/bin:/system/xbin
    export ANDROID_BOOTLOGO 1
    export ANDROID_ROOT /system
    export ANDROID_ASSETS /system/app
    export ANDROID_DATA /data
    export ANDROID_STORAGE /storage
    export ASEC_MOUNTPOINT /mnt/asec
    export LOOP_MOUNTPOINT /mnt/obb
    # FireOS sets these in init.ssd.rc. Without them a normal app fork aborts:
    # MountEmulatedStorage() (com_android_internal_os_Zygote.cpp) returns false
    # when EMULATED_STORAGE_SOURCE/TARGET/EXTERNAL_STORAGE are undefined, and
    # the caller turns that into "Cannot continue without emulated storage" +
    # RuntimeAbort, which kills the whole zygote. Measured: zygote aborted in a
    # loop the moment system_server started the FireOS OOBE app.
    export EXTERNAL_STORAGE /storage/emulated/legacy
    export EMULATED_STORAGE_SOURCE /mnt/shell/emulated
    export EMULATED_STORAGE_TARGET /storage/emulated
    export BOOTCLASSPATH /system/framework/core-libart.jar:/system/framework/conscrypt.jar:/system/framework/okhttp.jar:/system/framework/core-junit.jar:/system/framework/bouncycastle.jar:/system/framework/ext.jar:/system/framework/framework.jar:/system/framework/telephony-common.jar:/system/framework/voip-common.jar:/system/framework/ims-common.jar:/system/framework/mms-common.jar:/system/framework/android.policy.jar:/system/framework/apache-xml.jar
    export SYSTEMSERVERCLASSPATH /system/framework/org.cyanogenmod.platform.jar:/system/framework/org.cyanogenmod.hardware.jar:/system/framework/services.jar:/system/framework/ethernet-service.jar:/system/framework/wifi-service.jar
    # ART signal-chain shim. CM's init.environ.rc preloads this into every
    # process so libart.so resolves its sigchain hooks; a missing lib here is a
    # linker warning, not fatal. (The Amazon fireos-res resource package and its
    # AMAZON_EXTRA_RESOURCE_LIST export are gone with the Amazon framework.)
    export LD_PRELOAD libsigchain.so

    symlink /system/etc /etc
    # No-op (EEXIST) when android-boot.sh made /vendor a directory for overlays.
    symlink /system/vendor /vendor

    mkdir /mnt 0775 root system
    mkdir /storage 0751 root sdcard_r
    # The emulated storage tree and links from FireOS's init.ssd.rc. The
    # bind mounts MountEmulatedStorage() makes need these to exist.
    mkdir /mnt/shell 0700 shell shell
    mkdir /mnt/shell/emulated 0700 shell shell
    mkdir /mnt/shell/emulated/0 0700 shell shell
    mkdir /storage/emulated 0555 root root
    symlink /storage/emulated/legacy /sdcard
    symlink /storage/emulated/legacy /mnt/sdcard
    symlink /storage/emulated/legacy /storage/sdcard0
    symlink /mnt/shell/emulated/0 /storage/emulated/legacy
    symlink /mnt/shell/emulated/0 /storage/emulated/0
    # The microSD card (fstab.icx): vold mounts it on /mnt/media_rw/sdcard1
    # and fuse_sdcard1 serves it as /storage/sdcard1, the path the ford
    # framework's storage list already declares.
    mkdir /mnt/media_rw 0700 media_rw media_rw
    mkdir /mnt/media_rw/sdcard1 0700 media_rw media_rw
    mkdir /storage/sdcard1 0700 root root
    export SECONDARY_STORAGE /storage/sdcard1
    # pivotinit leaves every mount private. Apps live in mount namespaces of
    # their own (zygote unshares one per app), so a card mounted after an app
    # started reaches it only through propagation from here.
    mount rootfs rootfs / shared rec
    mkdir /data 0771 system system
    mkdir /cache 0771 system cache
    mkdir /dev/socket 0775 root system
    mkdir /dev/logd 0770 logd log

    # Mirrors FireOS's own post-fs-data list. Each of these was needed by
    # something: zygote aborts with "Error creating cache dir
    # /data/dalvik-cache/arm", installd gives up with "media fs prepare failed"
    # (which leaves PackageManager unable to create data dirs for any package),
    # and PackageManagerService's deleteTempPackageFiles NPEs on the null
    # listFiles() of a missing /data/app-private. Ownership and modes are
    # copied from FireOS's init.rc so the framework finds what it expects.
    mkdir /data/app 0771 system system
    mkdir /data/app-private 0771 system system
    mkdir /data/app-lib 0771 system system
    mkdir /data/app-asec 0700 root root
    mkdir /data/data 0771 system system
    mkdir /data/property 0700 root root
    mkdir /data/local 0751 root root
    mkdir /data/local/tmp 0771 shell shell
    mkdir /data/dalvik-cache 0771 root root
    mkdir /data/dalvik-cache/profiles 0711 system system
    mkdir /data/dalvik-cache/arm 0771 system system
    mkdir /data/resource-cache 0771 system system
    mkdir /data/misc 01771 system misc
    mkdir /data/misc/adb 02750 system shell
    mkdir /data/misc/bluetooth 0770 system system
    # bluedroid (bluetooth.default.so) keeps bt_config.xml, the pairing keys and
    # its a2dp sockets here; the Fire/CM ramdisk init.rc makes it the same way.
    mkdir /data/misc/bluedroid 0770 bluetooth net_bt_stack
    mkdir /data/misc/keychain 0771 system system
    mkdir /data/misc/keystore 0700 keystore keystore
    mkdir /data/misc/net 0750 root shell
    mkdir /data/misc/radio 0770 system radio
    mkdir /data/misc/sms 0770 system radio
    mkdir /data/misc/zoneinfo 0775 system system
    mkdir /data/misc/vpn 0770 system vpn
    mkdir /data/misc/shared_relro 0771 shared_relro shared_relro
    mkdir /data/misc/systemkeys 0700 system system
    mkdir /data/misc/wifi 0770 wifi wifi
    mkdir /data/misc/wifi/sockets 0770 wifi wifi
    mkdir /data/misc/wifi/wpa_supplicant 0770 wifi wifi
    mkdir /data/misc/ethernet 0770 system system
    mkdir /data/misc/dhcp 0770 dhcp wifi
    mkdir /data/misc/user 0771 root root
    mkdir /data/misc/user/0 0771 root root
    mkdir /data/misc/media 0700 media media
    mkdir /data/media 0770 media_rw media_rw
    mkdir /data/media/obb 0770 media_rw media_rw
    mkdir /data/media/0 0770 media_rw media_rw
    mkdir /data/media/0/Android 0770 media_rw media_rw
    mkdir /data/media/0/Android/data 0770 media_rw media_rw
    mkdir /data/media/0/Android/obb 0770 media_rw media_rw
    mkdir /data/system 0775 system system
    mkdir /data/system/dropbox 0700 system system
    mkdir /data/dontpanic 0750 root log
    mkdir /data/tombstones 0771 system system
    mkdir /data/anr 0775 system system
    mkdir /data/logd 0770 logd log

    # /init.rc is parsed before /data and /cache are mounted by the host side,
    # but the directories themselves are already there. Android's built-in
    # late-init chain is not in this file, so start it from here.
    trigger late-init

# FireOS loads /system/build.prop, /system/default.prop, /vendor/build.prop,
# /data/local.prop and /data/property/* with this command; it is what supplies
# ro.board.platform=mt8127 (how the MTK HALs are found) and the dalvik.vm.*
# properties zygote reads. Its trigger normally comes from late-init.
on load_all_props_action
    load_all_props

on late-init
    trigger load_all_props_action
    trigger boot

on boot
    # The ford build ships tablet heap sizes (heapsize 256m, dex2oat-Xmx 512m).
    # ART mmaps its whole -Xmx up front, so these have to come down to fit
    # 456 MB of RAM. They must be set before zygote starts, i.e. here. This image
    # is NOT dexpreopted, so the first boot runs a full dex2oat under these caps.
    setprop dalvik.vm.heapstartsize 8m
    setprop dalvik.vm.heapgrowthlimit 48m
    setprop dalvik.vm.heapsize 128m
    setprop dalvik.vm.heapminfree 512k
    setprop dalvik.vm.heapmaxfree 2m
    setprop dalvik.vm.heaptargetutilization 0.75
    setprop dalvik.vm.dex2oat-Xms 16m
    setprop dalvik.vm.dex2oat-Xmx 96m
    setprop dalvik.vm.image-dex2oat-Xms 16m
    setprop dalvik.vm.image-dex2oat-Xmx 96m
    # dex2oat gives up after 6 minutes ("did not finish after 360 seconds",
    # exit 1), and Firefox takes longer than that here, so its dexopt failed on
    # every boot and held SystemServer for those 6 minutes each time (10-22).
    # installd appends this property to every dex2oat command line.
    setprop dalvik.vm.dex2oat-flags --no-watch-dog

    # Bluetooth, MTK CONSYS stack from the CM image (libbt-vendor.so ->
    # libbluetooth_mtk.so). See devlog/2026-10-15-bt-consys-groundwork.md.
    #
    # The chip is brought up by the Sony host (6620_launcherA + the mtk_stp_*_soc
    # modules); the container only opens /dev/stpbt. libbluetooth_mtk.so reads one
    # property, persist.mtk.wcn.combo.chipid, and runs its HCI init script only
    # for 0x8127 ("Unknown combo chip id" / "No matching init script" for any
    # other value). This kernel reports 0x8590. Sony's own libbtdrv.so runs
    # bt_init_script_consys for it, which sends the same HCI vendor commands as
    # CM's 0x8127 script (BD address, radio, TX power offset, sleep timeout,
    # reset, FW syslog; Sony adds a PCM/SCO block that CM keeps in a separate,
    # empty script), and Sony's 0x8590 default record equals CM's 0x8127 one apart
    # from the placeholder address. So tell CM's code the chip is a 0x8127. This
    # is a container-local property; the host's value is untouched.
    setprop persist.mtk.wcn.combo.chipid 0x8127
    # libbluetooth_mtk.so waits up to 5 s (10 x 0.5 s) for service.nvram_init to
    # read Ready. Unset, that wait outlasts bluedroid's own 5 s preload timeout
    # ("preload_wait_timeout"): the vendor init is torn down and retried, the
    # 12 s enable timeout expires, and com.android.bluetooth dies with SIGSEGV
    # in bte_ssr_cleanup. With bluetooth_on=1 that repeated every ~45 s
    # (2026-10-19). With Ready, libnvram finds no /data/nvram and the library
    # goes on with its defaults (the eFUSE address query runs, the write-back
    # logs "Open BT NVRAM fails errno 13"); enable took 0.4 s.
    setprop service.nvram_init Ready
    #
    # Services that must NOT be added to this file (android-boot.sh refuses to
    # start if one appears): wmt_loader / wmtLoader (re-probes the chip and
    # rewrites the chipid property), 6620_launcher / conn_launcher (opens
    # /dev/stpwmt, which does not exist on this kernel; the node is
    # /dev/stpwmtA and Sony's launcher on the host holds it), nvram_daemon /
    # NvRAMAgent (restores from the NVRAM partition).

    # AOSP/CM SurfaceFlinger takes panel rotation from ro.sf.hwrotation (set in
    # default.aosp.prop), not FireOS's persist.panel.orientation, so that setprop
    # is dropped here. The ford system.prop ships ro.sf.hwrotation=270 for the
    # tablet's landscape-native panel; our 480x800 portrait panel needs a value
    # to be confirmed on the first fbcap capture.

    # Order matters here. ueventd is the only thing that turns uevents into
    # /dev nodes, so stop it first: after that nothing can recreate the raw eMMC
    # nodes, including vold's coldboot of /sys/block. Then clean /dev. devclean
    # is asynchronous (see its header), so it may still be running while the
    # services below start; vold waits for it (below).
    stop ueventd
    start devclean

    class_start core
    class_start main

# vold makes the card's nodes itself, in /dev/block/vold, and devclean removes
# all of /dev/block, so vold starts only once devclean is done. vold's own
# mkdir of /dev/block/vold fails without the parent.
on property:init.svc.devclean=stopped
    mkdir /dev/block 0755 root root
    mkdir /dev/block/vold 0755 root root
    start vold

# FireOS's init has no working "exec": AOSP 5.1's do_exec is a stub that just
# returns -1 (init/builtins.c:257-260), so an "exec -- /system/bin/sh ..." line
# is accepted and then does nothing. Measured: with exec, the container's /dev
# still held 41 raw eMMC names after boot, while running devclean.sh by hand
# removed them. Run it as a oneshot service instead: "start" clears
# SVC_DISABLED (init/init.c:180) and, having no class, nothing else starts it.
service devclean /system/bin/sh /devclean.sh
    oneshot
    disabled

# Started from early-init; deliberately not in a class so class_start does not
# bring it back after devclean.sh has run.
service ueventd /sbin/ueventd

# MountService blocks startOtherServices on waitForAsecScan() until vold
# connects (AOSP 5.1.1 SystemServer.java:721, MountService.java:867). vold
# manages one volume, the microSD slot in /fstab.icx; the device script refuses
# to start if the fstab names anything else. Started by the devclean trigger
# above, not by class_start.
service vold /system/bin/vold
    class core
    socket vold stream 0660 root mount
    ioprio be 2
    disabled

# vold starts this once the card is mounted (ctl.start fuse_<label>) and stops
# it before unmounting. Apps holding READ_EXTERNAL_STORAGE (sdcard_r) can read,
# only media_rw writes, as on stock 5.1 secondary storage.
service fuse_sdcard1 /system/bin/sdcard -u 1023 -g 1023 -w 1023 -d /mnt/media_rw/sdcard1 /storage/sdcard1
    disabled

# system_server's BatteryService binds android.os.IBatteryPropertiesRegistrar,
# which healthd publishes. Without it BatteryService.onStart throws a null
# registrar and system_server aborts.
service healthd /sbin/healthd
    class core

service netd /system/bin/netd
    class main
    socket netd stream 0660 root system
    socket dnsproxyd stream 0660 root inet
    socket mdns stream 0660 root system
    socket fwmarkd stream 0660 root inet

# system_server's AudioService waits for media.audio_flinger and
# media.audio_policy before it finishes booting, and without them the boot stops
# at "Waiting for service media.audio_flinger...". mediaserver publishes both
# before it touches any audio HAL: AudioFlinger::onFirstRef loads none
# (frameworks/av services/audioflinger/AudioFlinger.cpp:212-235), and the policy
# service's early return on failure (AudioPolicyService.cpp:87-113) happens
# after addService. The MTK primary HAL is kept out of the container by
# android-boot.sh, because it links libnvram/libcustom_nvram, which reach for
# the NVRAM and PRO_INFO partitions.
service media /system/bin/mediaserver
    class main
    user media
    group audio camera inet net_bt net_bt_admin net_bw_acct drmrpc mediadrm drm media
    ioprio rt 4

service logd /system/bin/logd
    class core
    socket logd stream 0666 logd logd
    socket logdr seqpacket 0666 logd logd
    socket logdw dgram 0222 logd logd
    group root system

# FireOS's init.rc:634-637 runs this as a critical class-core service with this
# socket. It is not optional: ActivityManagerService applies oom_adj only by
# writing LMK_PROCPRIO to this socket (AOSP 5.1.1 ProcessList.java:600-614,
# writeLmkd at :645-655 retries three times with one-second sleeps and then
# gives up), with no fallback to /proc/<pid>/oom_score_adj. Without it every
# setOomAdj costs AMS three seconds ("SLOW OOM ADJ: 3003ms") and no process is
# ever ranked, so on 456 MB the kernel has nothing to kill by. Deliberately not
# marked critical: a critical service that exits makes init call do_reboot(),
# which would reset the device.
service lmkd /system/bin/lmkd
    class core
    socket lmkd seqpacket 0660 system system

service debuggerd /system/bin/debuggerd
    class main

# Shared storage, as FireOS's init.ssd.rc serves it: /data/media through FUSE
# on /mnt/shell/emulated. Zygote binds /mnt/shell/emulated/0 over each app's
# /storage/emulated/0; without the daemon that source is a root-only directory
# in the container root, so no app could read or write external storage
# (WalkmanUI found no Music folder, 2026-10-19).
service sdcard /system/bin/sdcard -u 1023 -g 1023 -l /data/media /mnt/shell/emulated
    class main

# ---- Wi-Fi (draft, not yet validated on the device) ------------------------
# Kernel side: the four modules are loaded by the HOST script before this init
# starts (android-boot.sh wifi_modules), which is also what makes ueventd create
# /dev/wmtWifi (ueventd.icx.rc: 0660 system system).
#
# Power-on. CM's libhardware_legacy does not write /dev/wmtWifi for a plain
# station: wifi_load_driver() is property_set("wlan.driver.status", "ok") and
# nothing else (disassembled, lib/libhardware_legacy.so 0x1cc8), and a raw
# string search of the whole CM image finds wifi_change_fw_path() only in that
# library and in netd. That one does write here: libhardware_legacy's fw path
# param is /dev/wmtWifi, and WifiStateMachine has netd reload the "STA"
# firmware on every enable. The stock chardev took that write as P2P
# registration, after which wpa_supplicant's first nl80211 request oopsed
# cfg80211 (device run 2026-10-15); the host loads a station-only chardev for
# that reason (probe/kmod/mtk-wmt-wifi-soc). The CM ramdisk has no wmtWifi power-on
# rule at all; the Fire ramdisk's init.mt8127.rc carries exactly the two
# triggers below, commented out (lines 559-563), so the stock Fire kernel must
# power the radio some other way. The Sony kernel with the WIFITEST modules
# does need the write (proven 2026-10-11), so init does it here.
# The write blocks init until the chip is up (about 1.5 s: firmware download),
# and init handles the next property message (ctl.start wpa_supplicant) only
# afterwards, so wlan0 exists by then.
# Careful: AOSP 5.1's init write opens with O_CREAT (not checked in Amazon's
# binary). If /dev/wmtWifi is missing, this would create a regular file of that
# name and the radio never starts. The operator checklist makes the node check
# the first step.
on property:wlan.driver.status=ok
    write /dev/wmtWifi "1"

on property:wlan.driver.status=unloaded
    write /dev/wmtWifi "0"

# Android's power menu ends in sys.powerctl. AOSP hands it to "powerctl", but
# this init may run without CAP_SYS_BOOT, and the Sony host must unmount its
# own filesystems first anyway. The request goes into /data, where the host's
# "android-boot.sh powerwatch" takes the container down and then powers off or
# reboots the Walkman.
on property:sys.powerctl=*
    write /data/misc/powerctl ${sys.powerctl}

# Verbatim from CM's init.mt8127.rc (ford ramdisk). wifi_start_supplicant()
# starts "wpa_supplicant" (or "p2p_supplicant" when the framework believes
# WiFi Direct exists), waits for init.svc.<name> = running, and the framework
# then talks to @android:wpa_wlan0 and /data/misc/wifi/sockets/wlan0.
service wpa_supplicant /system/bin/wpa_supplicant \
    -iwlan0 -Dnl80211 -c/data/misc/wifi/wpa_supplicant.conf -e/data/misc/wifi/entropy.bin \
    -I/system/etc/wifi/wpa_supplicant_overlay.conf \
    -O/data/misc/wifi/sockets -g@android:wpa_wlan0
    class main
    socket wpa_wlan0 dgram 660 wifi wifi
    disabled
    oneshot

# Safety net only: android-boot.sh hides android.hardware.wifi.direct, so this
# should never start. CM's own p2p_supplicant line also brings up -ip2p0, which
# this driver does not create (iw phy: IBSS and managed only), and wpa_supplicant
# exits when one of its interfaces fails. This single-interface variant keeps
# Wi-Fi working if the permissions overlay is ever missing.
service p2p_supplicant /system/bin/wpa_supplicant \
    -iwlan0 -Dnl80211 -c/data/misc/wifi/wpa_supplicant.conf -e/data/misc/wifi/entropy.bin \
    -I/system/etc/wifi/wpa_supplicant_overlay.conf \
    -O/data/misc/wifi/sockets -g@android:wpa_wlan0
    class main
    socket wpa_wlan0 dgram 660 wifi wifi
    disabled
    oneshot

# DHCP. libnetutils (dhcp_do_request) starts "dhcpcd_<iface>" with the
# interface as a dynamic argument (this init supports that for oneshot services)
# and reads dhcp.<iface>.* properties that the dhcpcd hook scripts set. DNS
# reaches the apps through netd's resolver (the framework pushes the
# dhcp.wlan0.dns* values to it); there is no resolv.conf to maintain.
service dhcpcd_wlan0 /system/bin/dhcpcd -ABK -dd
    class main
    user dhcp
    group net_admin net_raw
    disabled
    oneshot

service iprenew_wlan0 /system/bin/dhcpcd -n
    class main
    user dhcp
    group net_admin net_raw
    disabled
    oneshot

# system_server's Installer blocks on installd ("Waiting for installd to be
# ready"), so it has to be running.
service installd /system/bin/installd
    class main
    socket installd stream 600 system system

# On the software keymaster android-boot.sh binds over keystore.mt8127.so: the
# MTK one needs a TEE keymaster this container cannot reach ("could not open
# keymaster device in keystore"). The framework does not do without keystore:
# CM's ProfileManagerService NPEs on it, which crashed Settings at the end of
# the setup wizard on a fresh /data.
service keystore /system/bin/keystore /data/misc/keystore
    class main
    user keystore
    group keystore drmrpc

# uid 100, not system/1000: the kernel's binder driver remembers the euid of the
# first context manager since boot, and on this device that was Sony's
# hagodaemon as uid 100. A different euid gets EPERM from BINDER_SET_CONTEXT_MGR.
service servicemanager /system/bin/servicemanager
    class core
    user 100
    group system
    onrestart restart zygote
    onrestart restart surfaceflinger

service surfaceflinger /system/bin/surfaceflinger
    class core
    user system
    group graphics drmrpc
    onrestart restart zygote

# SurfaceFlinger starts this itself with "ctl.start bootanim", which is where
# the earlier "init: no such service 'bootanim'" came from. disabled + oneshot
# means only that request starts it.
service bootanim /system/bin/bootanimation
    class core
    user graphics
    group graphics audio
    disabled
    oneshot

service zygote /system/bin/app_process -Xzygote /system/bin --zygote --start-system-server
    class main
    socket zygote stream 660 root system
