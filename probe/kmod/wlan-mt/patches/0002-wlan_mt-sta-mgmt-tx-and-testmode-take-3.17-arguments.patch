+#if CONFIG_MTK_BENTEN_SUPPORT
+int
+mtk_cfg80211_mgmt_tx (
+    struct wiphy *wiphy,
+    struct wireless_dev *wdev,
+    struct cfg80211_mgmt_tx_params *params,
+    u64 *cookie
+    );
+#elif LINUX_VERSION_CODE < KERNEL_VERSION(3, 8, 0)
 int
 mtk_cfg80211_mgmt_tx (
     struct wiphy *wiphy,
@@ -437,12 +445,22 @@
