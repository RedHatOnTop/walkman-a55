+++ b/drivers/net/wireless/mt_soc/conn_soc/mt_wifi/wlan/os/linux/include/gl_os.h	2026-10-11 01:32:57.117633173 +0000
@@ -623,6 +623,17 @@
 #include "wlan_lib.h"
 #include "wlan_oid.h"
 
+/* A55 port: stock kernel is built without CONFIG_WIRELESS_EXT, so the WEXT core
+ * (and its exported wireless_send_event) does not exist. cfg80211/nl80211 events
+ * are unaffected; legacy WEXT events are simply dropped, which is exactly what a
+ * WEXT-less kernel would do. */
+#ifndef CONFIG_WIRELESS_EXT
+#include <net/iw_handler.h>
+#undef wireless_send_event
+#define wireless_send_event(dev, cmd, wrqu, extra) \
+	do { (void)(dev); (void)(cmd); (void)(wrqu); (void)(extra); } while (0)
+#endif
+
 #if CFG_ENABLE_AEE_MSG
 #include <linux/aee.h>
 #endif
