# Out-of-tree kbuild file for mtk_wmt_wifi_soc.ko, the /dev/wmtWifi chardev of
# the MT8590 CONSYS, station-only (see the port notes in wmt_chrdev_wifi.c).
# Include paths and defines are the WIFITEST bundle's
# (work/wifitest/bundle/WIFITEST/src-mtk_wmt_wifi_soc/Makefile).
# $(srctree) is the kernel tree given to make -C.
include $(srctree)/drivers/misc/mediatek/Makefile.custom

CONN := $(srctree)/drivers/misc/mediatek/conn_soc/common

ccflags-y += -I$(CONN)/linux/include \
             -I$(CONN)/linux/pri/include \
             -I$(CONN)/core/include \
             -I$(CONN)/include \
             -I$(CONN)/mt8590/include \
             -I$(CONN)/ \
             -I$(CONN)/../../btif/inc \
             -I$(CONN)/../../common_detect
ccflags-y += -DWMT_PLAT_ALPS -DWMT_CREATE_NODE_DYNAMIC=1 -DMTK_WCN_WMT_STP_EXP_SYMBOL_ABSTRACT

obj-m += mtk_wmt_wifi_soc.o
mtk_wmt_wifi_soc-objs := wmt_chrdev_wifi.o
