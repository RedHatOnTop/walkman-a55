+    // The stock layout sizes the icon pages for two heights: 6 + 400 above
+    // BasicPlayerControls, 24 + 504 without them (each row 26 px taller to
+    // touch), the dots 31 below the pages and 10 above the controls. With no
+    // function icon row the screen is taller than the first, and the rows take
+    // the spare height up to the second; the top margin takes what whole rows
+    // leave, so the dots stay 10 above the controls. The screen area already
+    // ends at the controls (ScreenController::ReconfigureScreenByWindow).
+    // LibraryTopHelpGuide.qml (0003) repeats this to frame the second row.
+    readonly property int spare_icon_height: function_icon_area.height === 0
+                                             ? root.height - (6 + 400 + 31 + 20 + 10) : 0
+    readonly property int icon_touch_extension:
+        Math.max(0, Math.min(26, Math.floor(spare_icon_height * 26 / (24 + 504 - 6 - 400))))
+    readonly property int icon_pages_top_margin:
+        Math.max(6, Math.min(24, 6 + spare_icon_height - 4 * icon_touch_extension))
